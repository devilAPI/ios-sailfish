+/*
+ * Power off / restart (SweetPlatformExpert::haltRestart): the last console
+ * lines into the log ring, then SYNCHRONIZE CACHE, so what HFS wrote at
+ * unmount is on flash before PS_HOLD drops. The lock is only tried: the
+ * system may be stopping with another thread holding it.
+ */
+void sweet_ufs_shutdown(void);
+void
+sweet_ufs_shutdown(void)
+{
+	if (!su.writable) {
+		return;
+	}
+	sweet_log_kick();
+	delay(300 * 1000);
+	bool locked = false;
+	for (int i = 0; i < 200 && !(locked = lck_mtx_try_lock(&sweet_ufs_lock)); i++) {
+		delay(10 * 1000);
+	}
+	int error = ufs_sync_cache();
+	if (locked) {
+		lck_mtx_unlock(&sweet_ufs_lock);
+	}
+	printf("SWEET UFS: write cache flushed for power off/restart (%d)\n", error);
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
