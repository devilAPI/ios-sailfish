+/*
+ * Power off and restart (iOS "slide to power off" / reboot): without this the
+ * base class returns and IOPlatformExpert panics "Halt/Restart Timed Out"
+ * 30 s later. As Linux on MSM8996 (qpnp-pon + msm-poweroff / PSCI):
+ *   1. UFS write cache flushed (sweet_ufs_shutdown)
+ *   2. PM8994 PON PS_HOLD_RESET_CTL (SID 0 PON 0x08xx +0x5a, enable bit 7 in
+ *      +0x5b): what the PMIC does when PS_HOLD drops, 4 = shutdown, 7 = hard
+ *      reset (disable, set type, enable)
+ *   3. restart: IMEM restart reason 0x77665501 (normal boot, not recovery)
+ *   4. PSCI SYSTEM_OFF (0x84000008) / SYSTEM_RESET (0x84000009): TrustZone
+ *      drops PS_HOLD
+ * Panics keep their own path (pstore, reset to recovery).
+ */
+extern "C" void sweet_ufs_shutdown(void);
+extern "C" bool sweet_pmic_write(uint16_t ppid, uint8_t addr, uint8_t val);
+extern "C" vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+
+#define PON_PPID                0x008u
+#define PON_PS_HOLD_RESET_CTL   0x5au
+#define PON_PS_HOLD_RESET_CTL2  0x5bu
+#define PON_TYPE_SHUTDOWN       4u
+#define PON_TYPE_HARD_RESET     7u
+
+int
+SweetPlatformExpert::haltRestart(unsigned int type)
+{
+	bool off;
+	switch (type) {
+	case kPEHaltCPU:
+	case kPEUPSDelayHaltCPU:
+		off = true;
+		break;
+	case kPERestartCPU:
+		off = false;
+		break;
+	default:
+		return IODTPlatformExpert::haltRestart(type);
+	}
+	IOLog("SWEET: %s\n", off ? "power off" : "restart");
+	sweet_ufs_shutdown();
+	uint8_t kind = off ? PON_TYPE_SHUTDOWN : PON_TYPE_HARD_RESET;
+	bool pon = sweet_pmic_write(PON_PPID, PON_PS_HOLD_RESET_CTL2, 0) &&
+	    (IODelay(100), sweet_pmic_write(PON_PPID, PON_PS_HOLD_RESET_CTL, kind)) &&
+	    sweet_pmic_write(PON_PPID, PON_PS_HOLD_RESET_CTL2, 0x80);
+	if (!off) {
+		vm_offset_t imem = ml_io_map(0x066bf000, 0x1000);
+		if (imem != 0) {
+			*(volatile uint32_t *)(imem + 0x65c) = 0x77665501;
+		}
+	}
+	IOLog("SWEET: PMIC PS_HOLD type %u %s; PSCI %s\n", kind, pon ? "set" : "NOT SET (PMIC default)",
+	    off ? "SYSTEM_OFF" : "SYSTEM_RESET");
+	IODelay(100 * 1000);    /* let the log line reach the screen */
+	__asm__ volatile("dsb sy" ::: "memory");
+	register uint64_t x0 __asm__("x0") = off ? 0x84000008ULL : 0x84000009ULL;
+	__asm__ volatile("smc #0" : "+r"(x0) : : "x1", "x2", "x3", "x4", "x5", "x6", "x7", "x8", "x9",
+	    "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "cc", "memory");
+	IOLog("SWEET: PSCI call returned %d\n", (int)x0);
+	return -1;
+}
