+/*
+ * Firmware crash (FW_IND_EVENT_PENDING): print, once, the register dump
+ * the firmware leaves at host interest hi_failure_state (60 words, as
+ * ath10k_pci_dump_registers: assert info, PC, bad address, registers)
+ * and the host's tx/rx state at that moment.
+ */
+static bool
+wl_fw_crashed(const char *where)
+{
+	if (wl_fw_dead) {
+		return true;
+	}
+	uint32_t fwi = rd(wl_bar, Q_FW_IND), area = 0, v[8];
+	if (!(fwi & 1u)) {
+		return false;
+	}
+	wl_fw_dead = true;
+	printf("SAILFISH WLAN: FIRMWARE CRASHED (%s): fw_ind %#x, tx ids busy %#x, frames out %u, slots reclaimed %u, full drops %u, rx alloc %u\n",
+	    where, fwi, wl_tx_busy, wl_tx_id, wl_tx_reclaimed, wl_tx_full, wl_htt_alloc);
+	if (!wl_diag_read32(HI(0x04), &area) || !area) {
+		printf("SAILFISH WLAN: firmware dump: no hi_failure_state (%#x)\n", area);
+		return true;
+	}
+	for (uint32_t i = 0; i < 60; i += 8) {
+		for (uint32_t j = 0; j < 8; j++) {
+			if (!wl_diag_read32(area + 4 * (i + j), &v[j])) {
+				return true;
+			}
+		}
+		printf("SAILFISH WLAN: firmware dump [%02u]: %08x %08x %08x %08x %08x %08x %08x %08x\n", i, v[0], v[1], v[2], v[3], v[4],
+		    v[5], v[6], v[7]);
+	}
+	sweet_log_kick();
+	return true;
