+/* HTT rx buffer for a ring address (NULL if it is not one of ours). */
+static volatile uint8_t *
+wl_htt_buf(uint32_t pa)
+{
+	uint32_t o = pa - (WL_DMA_PA + D_HTT_BUF);
+	if (pa < WL_DMA_PA + D_HTT_BUF || o >= 2048 * HTT_RING_N || (o & 2047u)) {
+		return NULL;
+	}
+	return (volatile uint8_t *)(wl_dma + D_HTT_BUF + o);
+}
+
+/* Give an emptied rx buffer back: its address at the alloc index (the caller publishes D_HTT_IDX). */
+static void
+wl_htt_refill(uint32_t pa)
+{
+	((volatile uint32_t *)(wl_dma + D_HTT_RING))[wl_htt_alloc] = pa;
+	wl_htt_alloc = (wl_htt_alloc + 1) & (HTT_RING_N - 1);
+}
