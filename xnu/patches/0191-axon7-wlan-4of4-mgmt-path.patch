+/*
+ * The same data frame (802.11 header + LLC/SNAP + body) sent on the
+ * management path (ext tid 17, raw frame, as auth and assoc): the firmware
+ * transmits it as built, past the data path's peer state. Used for EAPOL 4/4
+ * when the data path does not complete it (Axon 7 firmware, HTT 3.28).
+ */
+static bool
+wl_data_tx_raw(const uint8_t *da, uint16_t type, const uint8_t *body, uint32_t len)
+{
+	static uint8_t f[2048];
+	uint32_t n = wl_hdr(f, 0x08, 0x01, da);
+	const uint8_t snap[8] = { 0xaa, 0xaa, 3, 0, 0, 0, (uint8_t)(type >> 8), (uint8_t)type };
+	if (n + 8 + len > sizeof(f)) {
+		return false;
+	}
+	memcpy(f + n, snap, 8);
+	memcpy(f + n + 8, body, len);
+	return wl_htt_tx(f, n + 8 + len, true);
+}
