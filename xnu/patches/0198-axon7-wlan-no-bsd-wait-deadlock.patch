+/*
+ * We match on IOResources with IOResourceMatch IOBSD, so BSD is up when
+ * start() runs. IONetworkController::start would otherwise wait for the
+ * IOBSD resource again, from inside the IOResources matching pass that is
+ * starting us: a deadlock whenever that pass is still running (the Xcode 16
+ * kernel, w10: no Wi-Fi at all and root mount's 30 s "!BSD" timeout).
+ */
+UInt32
+SailfishWLAN::getFeatures(void) const
+{
+	return super::getFeatures() | kIONetworkFeatureNoBSDWait;
+}
