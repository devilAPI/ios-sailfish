-	setProperty("SurfaceHeight", (unsigned long long)(111 << 16), 32);
+	setProperty("SurfaceWidth", (unsigned long long)(68 << 16), 32);	/* mm, 16.16 (5.5" 16:9) */
+	setProperty("SurfaceHeight", (unsigned long long)(122 << 16), 32);
 	gSweetTouch = this;
 	registerService();
 	IOLog("SWEET HID: touch registered\n");
