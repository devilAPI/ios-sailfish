diff --git a/bsd/dev/sweet_touch.c b/bsd/dev/sweet_touch.c
index 3f2c89d..1b5d9c9 100644
--- a/bsd/dev/sweet_touch.c
+++ b/bsd/dev/sweet_touch.c
@@ -1,4 +1,12 @@
 /*
+ * ZTE Axon 7 (ailsa_ii): Synaptics DSX (RMI4) at I2C 0x20 on BLSP2 QUP6
+ * (0x75ba000, blsp_i2c12): GCC BLSP2 AHB vote (0x352004 bit 15), QUP6 I2C
+ * branch 0x330008 / RCGR 0x330020 (mainline gcc-msm8996.c), SDA/SCL TLMM
+ * 87/88 function 3, reset 89, attention 125 (as the Pixel), no I2C mux,
+ * rails PM8994 L14 1.8 V (vdd_ana) and L22 3.3 V (vcc_i2c) from its live
+ * DT, coordinates 1440 x 2560. The Pixel 1 notes below still describe the
+ * driver itself.
+ *
  * Pixel 1 (sailfish) touch: Synaptics S3708 (RMI4, F12 2D sensor) at I2C
  * 0x20 on BLSP1 QUP3 (0x7577000), polled. Call once after the scheduler is
  * running; all work runs on one thread.
@@ -38,14 +46,14 @@ extern bool sweet_rpm_ldoa(unsigned ldo, uint32_t uv);
 void sweet_touch_init(void);
 
 #define TOUCH_GCC_VOTE_PA 0x00352000u   /* +4: APCS_CLOCK_BRANCH_ENA_VOTE */
-#define TOUCH_GCC_QUP_PA  0x0031d000u   /* +8: QUP3 I2C CBCR, +0x20: RCGR */
-#define TOUCH_QUP_PA      0x07577000u
+#define TOUCH_GCC_QUP_PA  0x00330000u   /* +8: BLSP2 QUP6 I2C CBCR, +0x20: RCGR */
+#define TOUCH_QUP_PA      0x075ba000u
 #define TOUCH_TLMM_PA     0x01010000u   /* one 4 KiB tile per GPIO: CFG +0, IN_OUT +4 */
-#define TOUCH_SDA         47u
-#define TOUCH_SCL         48u
+#define TOUCH_SDA         87u
+#define TOUCH_SCL         88u
 #define TOUCH_RESET       89u
 #define TOUCH_ATTN        125u
-#define TOUCH_SWITCH      80u
+#define TOUCH_SWITCH      TOUCH_ATTN      /* no I2C mux: only read */
 #define TOUCH_ADDR        0x20u
 #define TOUCH_MAX         10u
 
@@ -186,7 +194,7 @@ touch_gpio(unsigned idx, unsigned func, unsigned pull, unsigned ma, bool out, bo
 static bool
 touch_clocks(void)
 {
-	touch_wr(st.vote, 4, touch_rd(st.vote, 4) | (1u << 17));      /* BLSP1 AHB */
+	touch_wr(st.vote, 4, touch_rd(st.vote, 4) | (1u << 15));      /* BLSP2 AHB */
 	touch_wr(st.gccqup, 8, touch_rd(st.gccqup, 8) | 1u);         /* QUP3 I2C */
 	for (unsigned i = 0; i < 1000; i++) {
 		if (!(touch_rd(st.gccqup, 8) & (1u << 31))) {
@@ -530,7 +538,7 @@ touch_thread(void *arg, wait_result_t result)
 	(void)PE_parse_boot_argn("sweetrpm", &rails, sizeof(rails));
 	if (rails) {
 		static const struct { unsigned ldo; uint32_t uv; } on[] = {
-			{6, 1800000}, {17, 3300000}, {18, 1800000}, {19, 2850000}, {23, 1800000},
+			{14, 1800000}, {22, 3300000},
 		};
 		for (unsigned i = 0; i < sizeof(on) / sizeof(on[0]); i++) {
 			(void)sweet_rpm_ldoa(on[i].ldo, on[i].uv);
@@ -541,7 +549,7 @@ touch_thread(void *arg, wait_result_t result)
 	 * Candidate touch rails (RPM-managed, always-on in Linux): PM8994 SID 1
 	 * LDOn at 0x4000 + 0x100 * (n - 1); +0x46 bit 7 enable, +0x40/+0x41 range/vset.
 	 */
-	static const unsigned ldos[] = {6, 17, 18, 19, 22, 23};
+	static const unsigned ldos[] = {14, 22};
 	for (unsigned i = 0; i < sizeof(ldos) / sizeof(ldos[0]); i++) {
 		uint16_t ppid = (uint16_t)(0x100u | (0x40u + ldos[i] - 1u));
 		uint8_t en = 0, rng = 0, vset = 0;
@@ -553,8 +561,7 @@ touch_thread(void *arg, wait_result_t result)
 	if (!touch_clocks()) {
 		goto out;
 	}
-	touch_gpio(4, 0, 0, 2, true, false);    /* I2C mux to the AP */
-	touch_gpio(0, 3, 0, 8, false, false);   /* blsp_i2c3, no pull (board pull-ups) */
+	touch_gpio(0, 3, 0, 8, false, false);   /* blsp_i2c12, no pull (board pull-ups) */
 	touch_gpio(1, 3, 0, 8, false, false);
 	touch_gpio(3, 0, 3, 16, false, false);  /* attention: input, pull-up */
 	/* DT: reset-active-ms 1, reset-delay-ms 20; give the firmware more time to boot. */
diff --git a/iokit/Kernel/arm/hid/SweetHID.cpp b/iokit/Kernel/arm/hid/SweetHID.cpp
index defe307..fde19e4 100644
--- a/iokit/Kernel/arm/hid/SweetHID.cpp
