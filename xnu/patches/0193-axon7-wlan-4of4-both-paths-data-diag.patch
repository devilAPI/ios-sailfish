+/*
+ * DHCP over Wi-Fi (diagnostics, 40 lines): ip is the IPv4 header of a
+ * frame going out to or coming in from the AP. Prints BOOTP op and the
+ * DHCP message type (1 DISCOVER, 2 OFFER, 3 REQUEST, 5 ACK, 6 NAK).
+ */
+static void
+wl_dhcp_log(const char *dir, const volatile uint8_t *ip, uint32_t n, const volatile uint8_t *da)
+{
+	static uint32_t lines;
+	if (lines >= 40 || n < 28 || (ip[0] >> 4) != 4 || ip[9] != 17) {
+		return;
+	}
+	uint32_t ihl = (ip[0] & 15u) * 4u, sp, dp;
+	if (ihl < 20 || ihl + 8 > n) {
+		return;
+	}
+	sp = ip[ihl] << 8 | ip[ihl + 1];
+	dp = ip[ihl + 2] << 8 | ip[ihl + 3];
+	if (!((sp == 68 && dp == 67) || (sp == 67 && dp == 68))) {
+		return;
+	}
+	uint32_t b = ihl + 8, type = 0;
+	for (uint32_t o = b + 240; b + 240 <= n && o + 2 <= n && ip[o] != 255;) {      /* options after the magic cookie */
+		if (ip[o] == 0) {
+			o++;
+			continue;
+		}
+		if (ip[o] == 53 && o + 2 < n) {
+			type = ip[o + 2];
+			break;
+		}
+		o += 2u + ip[o + 1];
+	}
+	lines++;
+	printf("SAILFISH WLAN: DHCP %s: op %u type %u, %u bytes, to %02x:%02x:%02x:%02x:%02x:%02x\n", dir, n > b ? ip[b] : 0, type, n,
+	    da[0], da[1], da[2], da[3], da[4], da[5]);
+}
 
