+/*
+ * ZTE Axon 7 Bluetooth, stage 1: bring up the Bluetooth half of the QCA6174
+ * ("ROME" 3.2: SoC 0x44, ROM 0x0302) on BLSP1 UART2 and test it from the
+ * kernel. Boot-arg axon7bt=1 (off by default), needs sailfishwlan=1 (the
+ * Wi-Fi driver powers the chip: rails, rome_vreg, sleep clock). Everything
+ * is logged ("AXON7 BT:").
+ *
+ * As postmarketOS's working setup (Linux hci_qca + btqca, DT blsp1_uart2
+ * "qcom,qca6174-bt", enable-gpios PM8994 GPIO 19, clock divclk4):
+ *   clocks   BLSP1 AHB (vote), UART2 core 3.6864 MHz (GPLL0 * 96/15625)
+ *   pins     TLMM 41-44 function 2 (blsp_uart2: TX, RX, CTS, RFR), 16 mA
+ *   UART     UARTDM 1.4 at 0x07570000, 8N1, 115200 (CSR divisor 2),
+ *            hardware flow control (auto RFR), polled (no interrupt)
+ *   power    PM8994 GPIO 19 (BT_EN) high after the Wi-Fi driver's chip
+ *            power step (it holds BT_EN low until then)
+ *   chip     H4: EDL version (0xFC00 0x19), rampatch and NVM as TLV
+ *            segments of 243 bytes (0xFC00 0x1E, vendor event per segment
+ *            unless the patch header's download mode skips it), the NVM
+ *            with the BD address (tag 2, boot-arg axon7btaddr), 115200
+ *            (tag 17) and no in-band sleep (tag 17 bit 7, tag 27 bit 0),
+ *            then HCI_Reset, Read_Local_Version, Read_BD_ADDR and a 4 s LE
+ *            scan as a receive test.
+ * Firmware from the payload: BT-RAMPATCH = qca/rampatch_00440302.bin,
+ * BT-NVM = qca/nvm_00440302.bin (linux-firmware, as postmarketOS).
+ * Boot-arg axon7bttest=SECS (test boots only): panic SECS after the test,
+ * so the panic path (pstore, reset to recovery) brings the phone to TWRP.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <kern/debug.h>
+#include <kern/sched_prim.h>
+#include <sys/conf.h>
